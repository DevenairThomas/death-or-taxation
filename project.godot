; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Death or Taxation"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"
run/main_scene="res://scenes/intro_screen/Intro Screen.tscn"

[autoload]

Calculators="*res://engine/systems/calculators.gd"
Combat_Calculator="*res://scenes/combat/combat_calculator.gd"
BattlefieldInfo="*res://engine/systems/game_system.tscn"
SceneTransition="*res://scenes/transition/Scene Transition.tscn"
Convoy="*res://scenes/convoy/convoy_canvas_layer.tscn"
WorldMapScreen="*res://scenes/world_map/World Map Screen.tscn"
StatusScreen="*res://scenes/gui/Status Screen/Status Screen.tscn"

